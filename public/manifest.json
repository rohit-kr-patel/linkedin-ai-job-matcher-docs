{
  "manifest_version": 3,
  "name": "LinkedIn AI Job Matcher",
  "version": "0.1.0",
  "description": "Shows a relevance score for LinkedIn jobs based on your resume skills.",
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
